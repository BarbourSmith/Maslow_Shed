                  "interpreterVersion": 1,
                  "code": "function run(\n  shape: Assembly,\n  wavelength: number = 10,\n  depth: number = 2,\n  flipSide: boolean = false,\n  reverseStart: boolean = false,\n) {\n  let EPS = 0.01; // how far the cutting tool extends outside the part (grows with part size)\n  const TOL = 1e-4; // distance at which edge endpoints count as touching\n  const MAX_TURN = Math.PI / 8; // max direction change covered by one Bezier on a curved edge\n  const k = (2 * Math.PI) / wavelength;\n  // Depth into the material at arc length u along a chain: the wave, or just outside the part\n  const wave = {\n    at: (u: number) => (depth * (1 - Math.cos(k * u))) / 2,\n    slope: (u: number) => (depth * k * Math.sin(k * u)) / 2,\n  };\n  const outside = { at: (u: number) => -EPS, slope: (u: number) => 0 };\n\n  // Arc length -> normalized edge parameter lookup, plus total turning angle\n  function prepEdge(edge: replicad.Edge) {\n    const len = edge.length;\n    let toParam = (s: number) => s / len;\n    let turn = 0;\n    if (edge.geomType !== \"LINE\") {\n      const N = 32;\n      const params = [0];\n      const lengths = [0];\n      let prevP = edge.pointAt(0);\n      let prevT = edge.tangentAt(0).normalize();\n      for (let i = 1; i <= N; i++) {\n        const p = edge.pointAt(i / N);\n        const t = edge.tangentAt(i / N).normalize();\n        lengths.push(lengths[i - 1] + p.sub(prevP).Length);\n        params.push(i / N);\n        turn += Math.acos(Math.min(1, Math.max(-1, t.dot(prevT))));\n        prevP = p;\n        prevT = t;\n      }\n      if (edge.geomType !== \"CIRCLE\") {\n        const scale = len / lengths[N];\n        toParam = (s: number) => {\n          let i = 1;\n          while (i < N && lengths[i] * scale < s) i++;\n          const a = lengths[i - 1] * scale;\n          const b = lengths[i] * scale;\n          return params[i - 1] + ((s - a) / (b - a)) * (params[i] - params[i - 1]);\n        };\n      }\n    }\n    return { edge, len, toParam, turn, start: edge.startPoint, end: edge.endPoint };\n  }\n\n  // An edge traversed in chain direction; s runs 0..len along it\n  function orient(info: any, reversed: boolean) {\n    const param = (s: number) => info.toParam(reversed ? info.len - s : s);\n    return {\n      info,\n      reversed,\n      len: info.len,\n      start: reversed ? info.end : info.start,\n      end: reversed ? info.start : info.end,\n      point: (s: number) => info.edge.pointAt(param(s)),\n      tangent: (s: number) =>\n        info.edge.tangentAt(param(s)).normalize().multiply(reversed ? -1 : 1),\n      u0: 0, // arc length along the chain where this edge starts\n      inSign: 1, // which side of the edge (within face B) the material is on\n    };\n  }\n\n  return shape.onLeafs((leaf) => {\n    if (leaf.geometry instanceof replicad.Drawing || !replicad.isShape3D(leaf.geometry)) {\n      return leaf;\n    }\n    const body = leaf.geometry;\n\n    // Gather the selected edges: directly selected edges first, in the order they were clicked,\n    // then the edges of any selected faces\n    let selectedEdges: replicad.Edge[] = [];\n    if (leaf.selection?.edges) {\n      selectedEdges.push(...leaf.selection.edges.map((index) => body.edges[index]));\n    }\n    selectedEdges = selectedEdges.filter((e) => e != null);\n    const clickedCount = selectedEdges.length;\n    if (leaf.selection?.faces) {\n      leaf.selection.faces.forEach((faceIndex) => {\n        selectedEdges.push(...body.faces[faceIndex].edges);\n      });\n    }\n    selectedEdges = selectedEdges.filter((e) => e != null);\n    // Faces share edges, so drop duplicates\n    selectedEdges = selectedEdges.filter(\n      (e, i) => selectedEdges.findIndex((other) => other.isSame(e)) === i,\n    );\n    if (selectedEdges.length === 0) {\n      return leaf;\n    }\n\n    const faces = body.faces;\n    const faceEdges = faces.map((f) => f.edges);\n    const adjacentFaces = (edge: replicad.Edge) =>\n      faces.map((f, i) => i).filter((i) => faceEdges[i].some((e) => e.isSame(edge)));\n\n    // Link touching edges into chains so the wave phase continues across them\n    const infos = selectedEdges.map((edge, rank) => ({ ...prepEdge(edge), rank, clicked: rank < clickedCount }));\n    const near = (a: replicad.Vector, b: replicad.Vector) => a.sub(b).Length < TOL;\n    const degree = (p: replicad.Vector) =>\n      infos.reduce((n, inf) => n + (near(inf.start, p) ? 1 : 0) + (near(inf.end, p) ? 1 : 0), 0);\n    const used = new Set<any>();\n    const chains: any[] = [];\n    while (used.size < infos.length) {\n      const remaining = infos.filter((inf) => !used.has(inf));\n      // Prefer starting at a free end so open chains are traversed end to end\n      let first = remaining.find((inf) => degree(inf.start) === 1);\n      let chain = [];\n      if (first) {\n        chain.push(orient(first, false));\n      } else {\n        first = remaining.find((inf) => degree(inf.end) === 1) ?? remaining[0];\n        chain.push(orient(first, degree(first.end) === 1));\n      }\n      used.add(first);\n      let next;\n      do {\n        const tip = chain[chain.length - 1].end;\n        next = infos.find((inf) => !used.has(inf) && (near(inf.start, tip) || near(inf.end, tip)));\n        if (next) {\n          chain.push(orient(next, !near(next.start, tip)));\n          used.add(next);\n        }\n      } while (next);\n      chains.push(chain);\n    }\n\n    const [bMin, bMax] = body.boundingBox.bounds;\n    const diagonal = Math.hypot(bMax[0] - bMin[0], bMax[1] - bMin[1], bMax[2] - bMin[2]);\n    EPS = Math.max(0.01, diagonal * 1e-5);\n    const throughDist = diagonal + 2 * EPS;\n    const smooth = (a: any, b: any) => a.tangent(a.len).dot(b.tangent(0)) > Math.cos(Math.PI / 180);\n\n    let tools: replicad.Shape3D | null = null;\n    const addTool = (tool: replicad.Shape3D) => {\n      tools = tools ? tools.fuse(tool) : tool;\n    };\n\n    const reverseChain = (chain: any[]) =>\n      chain\n        .slice()\n        .reverse()\n        .map((oe: any) => orient(oe.info, !oe.reversed));\n\n    chains.forEach((chain) => {\n      const closed = near(chain[chain.length - 1].end, chain[0].start);\n\n      // Pick where the wave starts: at the edge that was clicked first\n      const clicked = chain\n        .map((oe: any, i: number) => ({ i, rank: oe.info.rank, clicked: oe.info.clicked }))\n        .filter((c: any) => c.clicked)\n        .sort((a: any, b: any) => a.rank - b.rank);\n      if (!closed) {\n        // Open chain: start from whichever free end is nearer the first-clicked edge\n        if (clicked.length > 0) {\n          const total = chain.reduce((sum: number, oe: any) => sum + oe.len, 0);\n          let before = 0;\n          for (let i = 0; i < clicked[0].i; i++) before += chain[i].len;\n          if (before + chain[clicked[0].i].len / 2 > total / 2) chain = reverseChain(chain);\n        }\n      } else if (clicked.length > 0) {\n        // Closed loop: start where the first-clicked edge begins, heading toward the second one\n        const first = clicked[0].i;\n        chain = chain.slice(first).concat(chain.slice(0, first));\n        const second = clicked.length > 1 ? (clicked[1].i - first + chain.length) % chain.length : 1;\n        if (second === chain.length - 1 && chain.length > 2) {\n          chain = reverseChain(chain);\n          chain = [chain[chain.length - 1], ...chain.slice(0, -1)];\n        }\n      } else {\n        // Loop from a face selection has no click order: start at a sharp corner to hide the seam\n        // where the phase restarts\n        const corner = chain.findIndex((oe: any, i: number) => !smooth(chain[(i + chain.length - 1) % chain.length], oe));\n        if (corner > 0) chain = chain.slice(corner).concat(chain.slice(0, corner));\n      }\n      if (reverseStart) chain = reverseChain(chain);\n\n      // The wave is drawn in a flat face shared by every edge in the chain\n      let common = adjacentFaces(chain[0].info.edge);\n      chain.forEach((oe: any) => {\n        const adj = adjacentFaces(oe.info.edge);\n        common = common.filter((i) => adj.includes(i));\n      });\n      common = common.filter((i) => faces[i].geomType === \"PLANE\");\n      if (common.length === 0) {\n        console.warn(\"Sine edge: touching edges must share a flat face, skipping\");\n        return;\n      }\n      // Default to the larger face (e.g. the top of a plate) so the side becomes wavy\n      common.sort((a, b) => replicad.measureArea(faces[b]) - replicad.measureArea(faces[a]));\n      const faceB = common[flipSide && common.length > 1 ? 1 : 0];\n      const nB = faces[faceB].normalAt(chain[0].start);\n\n      let u = 0;\n      for (const oe of chain) {\n        oe.u0 = u;\n        u += oe.len;\n        // Material is on the side away from the other adjacent face's normal\n        const faceA = adjacentFaces(oe.info.edge).find((i) => i !== faceB);\n        if (faceA === undefined) {\n          console.warn(\"Sine edge: edge does not border two faces, skipping\");\n          return;\n        }\n        const mid = oe.point(oe.len / 2);\n        const side = nB.cross(oe.tangent(oe.len / 2));\n        oe.inSign = side.dot(faces[faceA].normalAt(mid)) > 0 ? -1 : 1;\n      }\n\n      const plane = new replicad.Plane(chain[0].start.add(nB.multiply(EPS)), chain[0].tangent(0), nB);\n      const to2D = (v: replicad.Vector) => {\n        const d = v.sub(plane.origin);\n        return [d.dot(plane.xDir), d.dot(plane.yDir)];\n      };\n\n      // Unit direction into the material, and the point offset by offset.at(u) along it\n      const inward = (oe: any, s: number) => nB.cross(oe.tangent(s)).multiply(oe.inSign);\n      const offsetPoint = (oe: any, s: number, offset: any) =>\n        oe.point(s).add(inward(oe, s).multiply(offset.at(oe.u0 + s)));\n      // Derivative of offsetPoint along s\n      const offsetDeriv = (oe: any, s: number, offset: any) => {\n        const t = oe.tangent(s);\n        const u = oe.u0 + s;\n        let result = t.add(inward(oe, s).multiply(offset.slope(u)));\n        if (oe.info.edge.geomType !== \"LINE\") {\n          // Rate at which the edge direction turns, from a small central difference\n          const h = oe.len * 1e-4;\n          const a = Math.max(0, s - h);\n          const b = Math.min(oe.len, s + h);\n          const dt = oe.tangent(b).sub(oe.tangent(a)).multiply(1 / (b - a));\n          result = result.add(nB.cross(dt).multiply(oe.inSign * offset.at(u)));\n        }\n        return result;\n      };\n\n      // Hermite Bezier (matching position and slope at both ends) of an offset curve over [s0, s1].\n      // Handles use the circular-arc length (4/3)tan(θ/4) instead of the plain 1/3, which keeps\n      // curved edges accurate at any scale; on straight edges the two are identical.\n      const bezier = (oe: any, s0: number, s1: number, offset: any) => {\n        const cosTurn = Math.min(1, Math.max(-1, oe.tangent(s0).dot(oe.tangent(s1))));\n        const turn = Math.acos(cosTurn);\n        const h = turn > 1e-9 ? ((s1 - s0) * (4 / 3) * Math.tan(turn / 4)) / turn : (s1 - s0) / 3;\n        const p0 = offsetPoint(oe, s0, offset);\n        const p1 = offsetPoint(oe, s1, offset);\n        return {\n          p0: to2D(p0),\n          p1: to2D(p1),\n          c1: to2D(p0.add(offsetDeriv(oe, s0, offset).multiply(h))),\n          c2: to2D(p1.sub(offsetDeriv(oe, s1, offset).multiply(h))),\n        };\n      };\n      // Number of Beziers needed so each one turns by at most MAX_TURN\n      const turnPieces = (oe: any, span: number) => Math.ceil((span / oe.len) * oe.info.turn / MAX_TURN);\n\n      // Wave segments along one edge between s = sA and s = sB, split at every quarter wave\n      function waveSegs(oe: any, sA: number, sB: number) {\n        const segs: any[] = [];\n        if (sB - sA < 1e-9) return segs;\n        const breaks = [sA];\n        const quarter = wavelength / 4;\n        for (let m = Math.ceil((oe.u0 + sA) / quarter); m * quarter < oe.u0 + sB; m++) {\n          const s = m * quarter - oe.u0;\n          if (s > sA + 1e-6 && s < sB - 1e-6) breaks.push(s);\n        }\n        breaks.push(sB);\n        // A trimmed end can leave a sliver next to a quarter break; merge it and split in two instead\n        const sliver = quarter / 4;\n        const merged = new Set<number>();\n        if (breaks.length > 2 && breaks[1] - breaks[0] < sliver) {\n          breaks.splice(1, 1);\n          merged.add(0);\n        }\n        if (breaks.length > 2 && breaks[breaks.length - 1] - breaks[breaks.length - 2] < sliver) {\n          breaks.splice(breaks.length - 2, 1);\n          merged.add(breaks.length - 2);\n        }\n        // On curved edges a single Bezier per quarter wave drifts, so use at least two\n        const minPieces = oe.info.edge.geomType !== \"LINE\" ? 2 : 1;\n        for (let i = 0; i + 1 < breaks.length; i++) {\n          const n = Math.max(merged.has(i) ? 2 : minPieces, turnPieces(oe, breaks[i + 1] - breaks[i]));\n          for (let j = 0; j < n; j++) {\n            const s0 = breaks[i] + ((breaks[i + 1] - breaks[i]) * j) / n;\n            const s1 = breaks[i] + ((breaks[i + 1] - breaks[i]) * (j + 1)) / n;\n            segs.push(bezier(oe, s0, s1, wave));\n          }\n        }\n        return segs;\n      }\n\n      // Segments just outside one edge, with the ends moved to the given corner points\n      function outerSegs(oe: any, startPt: number[] | null, endPt: number[] | null) {\n        let segs: any[];\n        if (oe.info.edge.geomType === \"LINE\") {\n          segs = [{ p0: to2D(offsetPoint(oe, 0, outside)), p1: to2D(offsetPoint(oe, oe.len, outside)) }];\n        } else {\n          const n = Math.max(1, turnPieces(oe, oe.len));\n          segs = [];\n          for (let j = 0; j < n; j++) segs.push(bezier(oe, (oe.len * j) / n, (oe.len * (j + 1)) / n, outside));\n        }\n        if (startPt) segs[0].p0 = startPt;\n        if (endPt) segs[segs.length - 1].p1 = endPt;\n        return segs;\n      }\n\n      // Classify each joint between consecutive edges (including the closing joint of a loop)\n      const joints: any[] = [];\n      const jointCount = closed ? chain.length : chain.length - 1;\n      for (let i = 0; i < jointCount; i++) {\n        const a = chain[i];\n        const b = chain[(i + 1) % chain.length];\n        const joint: any = { a, b, kind: smooth(a, b) ? \"smooth\" : \"sharp\" };\n        if (joint.kind === \"sharp\") {\n          const corner = a.end;\n          const n1 = inward(a, a.len);\n          const n2 = inward(b, 0);\n          // Convex when the next edge heads into the material, so the wave curves overlap\n          joint.convex = b.tangent(0).dot(n1) > 0;\n          // Mitered corner of the outline just outside the part\n          joint.outer = to2D(corner.sub(n1.add(n2).multiply(EPS / (1 + n1.dot(n2)))));\n          joint.corner = corner;\n          joint.n1 = n1;\n          joint.n2 = n2;\n        }\n        joints.push(joint);\n      }\n\n      // At convex corners, trim both wave curves back to where they cross the corner bisector\n      const sStart = chain.map(() => 0);\n      const sEnd = chain.map((oe: any) => oe.len);\n      const across = (joint: any, oe: any, s: number) => {\n        const m = joint.a.tangent(joint.a.len).add(joint.b.tangent(0)).normalize();\n        return offsetPoint(oe, s, wave).sub(joint.corner).dot(m);\n      };\n      const findCrossing = (f: (s: number) => number, lo: number, hi: number) => {\n        for (let i = 0; i < 40; i++) {\n          const mid = (lo + hi) / 2;\n          if (f(mid) > 0) hi = mid;\n          else lo = mid;\n        }\n        return (lo + hi) / 2;\n      };\n      joints.forEach((joint, i) => {\n        if (joint.kind !== \"sharp\" || !joint.convex) return;\n        const ia = i;\n        const ib = (i + 1) % chain.length;\n        const fa = (s: number) => across(joint, joint.a, s);\n        const fb = (s: number) => across(joint, joint.b, s);\n        if (fa(joint.a.len) > 0) sEnd[ia] = fa(sStart[ia]) > 0 ? sStart[ia] : findCrossing(fa, sStart[ia], joint.a.len);\n        if (fb(0) < 0) sStart[ib] = fb(sEnd[ib]) < 0 ? sEnd[ib] : findCrossing(fb, 0, sEnd[ib]);\n      });\n\n      // Connector from the end of one edge's wave to the start of the next\n      const connector = (joint: any, i: number) => {\n        const ib = (i + 1) % chain.length;\n        const from = offsetPoint(joint.a, sEnd[i], wave);\n        const to = offsetPoint(joint.b, sStart[ib], wave);\n        if (from.sub(to).Length < 1e-7) return [];\n        if (joint.kind === \"sharp\" && !joint.convex) {\n          // Concave corner: follow a circle around the corner, as an offset curve would\n          const da = wave.at(joint.a.u0 + joint.a.len);\n          const db = wave.at(joint.b.u0);\n          if (da > 1e-6 && Math.abs(da - db) < 1e-9) {\n            const mid = joint.corner.add(joint.n1.add(joint.n2).normalize().multiply(da));\n            return [{ p1: to2D(to), mid: to2D(mid) }];\n          }\n        }\n        return [{ p1: to2D(to) }];\n      };\n\n      // Wave path along the whole chain\n      const edgeSegs = chain.map((oe: any, i: number) => waveSegs(oe, sStart[i], sEnd[i]));\n      let waveStart = to2D(offsetPoint(chain[0], sStart[0], wave));\n      const wavePath: any[] = [];\n      chain.forEach((oe: any, i: number) => {\n        const segs = edgeSegs[i];\n        wavePath.push(...segs);\n        if (i >= joints.length) return;\n        const joint = joints[i];\n        const ib = (i + 1) % chain.length;\n        const gap = () => {\n          const from = segs[segs.length - 1].p1;\n          const to = edgeSegs[ib][0].p0;\n          return Math.hypot(from[0] - to[0], from[1] - to[1]);\n        };\n        const joinable = segs.length > 0 && edgeSegs[ib].length > 0;\n        if (joinable && ((joint.kind === \"sharp\" && joint.convex) || gap() < EPS)) {\n          // Ends that nearly meet (e.g. trimmed ends on the bisector) are joined at their midpoint\n          // rather than bridged, which would leave a sliver face\n          const next = edgeSegs[ib][0].p0;\n          const last = segs[segs.length - 1];\n          last.p1 = [(last.p1[0] + next[0]) / 2, (last.p1[1] + next[1]) / 2];\n          if (ib === 0) waveStart = last.p1;\n        } else {\n          wavePath.push(...connector(joint, i));\n        }\n      });\n\n      // Outline just outside the part along the whole chain\n      const outerPath: any[] = [];\n      chain.forEach((oe: any, i: number) => {\n        const before = i > 0 ? joints[i - 1] : closed ? joints[joints.length - 1] : null;\n        const after = i < joints.length ? joints[i] : null;\n        outerPath.push(\n          ...outerSegs(\n            oe,\n            before?.kind === \"sharp\" ? before.outer : null,\n            after?.kind === \"sharp\" ? after.outer : null,\n          ),\n        );\n      });\n\n      const trace = (pen: any, segs: any[]) => {\n        segs.forEach((g) => {\n          if (g.c1) pen = pen.cubicBezierCurveTo(g.p1, g.c1, g.c2);\n          else if (g.mid) pen = pen.threePointsArcTo(g.p1, g.mid);\n          else pen = pen.lineTo(g.p1);\n        });\n        return pen;\n      };\n      const extrude = (drawing: any) =>\n        drawing.sketchOnPlane(plane).extrude(throughDist, { extrusionDirection: nB.multiply(-1) });\n\n      if (closed) {\n        // Tool is the band between the wave loop and the loop just outside the part\n        const loop = (start: number[], segs: any[]) => {\n          const last = segs[segs.length - 1];\n          if (Math.hypot(last.p1[0] - start[0], last.p1[1] - start[1]) < 1e-6) last.p1 = start;\n          return trace(replicad.draw(start), segs).close();\n        };\n        const waveSolid = extrude(loop(waveStart, wavePath));\n        const outerSolid = extrude(loop(outerPath[0].p0, outerPath));\n        addTool(\n          replicad.measureVolume(waveSolid) > replicad.measureVolume(outerSolid)\n            ? waveSolid.cut(outerSolid)\n            : outerSolid.cut(waveSolid),\n        );\n        return;\n      }\n      const outerBack = outerPath\n        .slice()\n        .reverse()\n        .map((g) => ({ p0: g.p1, p1: g.p0, c1: g.c2, c2: g.c1 }));\n      let pen = replicad.draw(outerPath[0].p0).lineTo(waveStart);\n      pen = trace(pen, wavePath).lineTo(outerBack[0].p0);\n      addTool(extrude(trace(pen, outerBack).close()));\n    });\n\n    if (tools) {\n      leaf.geometry = body.cut(tools);\n    }\n    return leaf;\n  });\n}",
                  "compiledCode": "\"use strict\";\nfunction run(shape, wavelength = 10, depth = 2, flipSide = false, reverseStart = false) {\n    let EPS = 0.01; // how far the cutting tool extends outside the part (grows with part size)\n    const TOL = 1e-4; // distance at which edge endpoints count as touching\n    const MAX_TURN = Math.PI / 8; // max direction change covered by one Bezier on a curved edge\n    const k = (2 * Math.PI) / wavelength;\n    // Depth into the material at arc length u along a chain: the wave, or just outside the part\n    const wave = {\n        at: (u) => (depth * (1 - Math.cos(k * u))) / 2,\n        slope: (u) => (depth * k * Math.sin(k * u)) / 2,\n    };\n    const outside = { at: (u) => -EPS, slope: (u) => 0 };\n    // Arc length -> normalized edge parameter lookup, plus total turning angle\n    function prepEdge(edge) {\n        const len = edge.length;\n        let toParam = (s) => s / len;\n        let turn = 0;\n        if (edge.geomType !== \"LINE\") {\n            const N = 32;\n            const params = [0];\n            const lengths = [0];\n            let prevP = edge.pointAt(0);\n            let prevT = edge.tangentAt(0).normalize();\n            for (let i = 1; i <= N; i++) {\n                const p = edge.pointAt(i / N);\n                const t = edge.tangentAt(i / N).normalize();\n                lengths.push(lengths[i - 1] + p.sub(prevP).Length);\n                params.push(i / N);\n                turn += Math.acos(Math.min(1, Math.max(-1, t.dot(prevT))));\n                prevP = p;\n                prevT = t;\n            }\n            if (edge.geomType !== \"CIRCLE\") {\n                const scale = len / lengths[N];\n                toParam = (s) => {\n                    let i = 1;\n                    while (i < N && lengths[i] * scale < s)\n                        i++;\n                    const a = lengths[i - 1] * scale;\n                    const b = lengths[i] * scale;\n                    return params[i - 1] + ((s - a) / (b - a)) * (params[i] - params[i - 1]);\n                };\n            }\n        }\n        return { edge, len, toParam, turn, start: edge.startPoint, end: edge.endPoint };\n    }\n    // An edge traversed in chain direction; s runs 0..len along it\n    function orient(info, reversed) {\n        const param = (s) => info.toParam(reversed ? info.len - s : s);\n        return {\n            info,\n            reversed,\n            len: info.len,\n            start: reversed ? info.end : info.start,\n            end: reversed ? info.start : info.end,\n            point: (s) => info.edge.pointAt(param(s)),\n            tangent: (s) => info.edge.tangentAt(param(s)).normalize().multiply(reversed ? -1 : 1),\n            u0: 0, // arc length along the chain where this edge starts\n            inSign: 1, // which side of the edge (within face B) the material is on\n        };\n    }\n    return shape.onLeafs((leaf) => {\n        if (leaf.geometry instanceof replicad.Drawing || !replicad.isShape3D(leaf.geometry)) {\n            return leaf;\n        }\n        const body = leaf.geometry;\n        // Gather the selected edges: directly selected edges first, in the order they were clicked,\n        // then the edges of any selected faces\n        let selectedEdges = [];\n        if (leaf.selection?.edges) {\n            selectedEdges.push(...leaf.selection.edges.map((index) => body.edges[index]));\n        }\n        selectedEdges = selectedEdges.filter((e) => e != null);\n        const clickedCount = selectedEdges.length;\n        if (leaf.selection?.faces) {\n            leaf.selection.faces.forEach((faceIndex) => {\n                selectedEdges.push(...body.faces[faceIndex].edges);\n            });\n        }\n        selectedEdges = selectedEdges.filter((e) => e != null);\n        // Faces share edges, so drop duplicates\n        selectedEdges = selectedEdges.filter((e, i) => selectedEdges.findIndex((other) => other.isSame(e)) === i);\n        if (selectedEdges.length === 0) {\n            return leaf;\n        }\n        const faces = body.faces;\n        const faceEdges = faces.map((f) => f.edges);\n        const adjacentFaces = (edge) => faces.map((f, i) => i).filter((i) => faceEdges[i].some((e) => e.isSame(edge)));\n        // Link touching edges into chains so the wave phase continues across them\n        const infos = selectedEdges.map((edge, rank) => ({ ...prepEdge(edge), rank, clicked: rank < clickedCount }));\n        const near = (a, b) => a.sub(b).Length < TOL;\n        const degree = (p) => infos.reduce((n, inf) => n + (near(inf.start, p) ? 1 : 0) + (near(inf.end, p) ? 1 : 0), 0);\n        const used = new Set();\n        const chains = [];\n        while (used.size < infos.length) {\n            const remaining = infos.filter((inf) => !used.has(inf));\n            // Prefer starting at a free end so open chains are traversed end to end\n            let first = remaining.find((inf) => degree(inf.start) === 1);\n            let chain = [];\n            if (first) {\n                chain.push(orient(first, false));\n            }\n            else {\n                first = remaining.find((inf) => degree(inf.end) === 1) ?? remaining[0];\n                chain.push(orient(first, degree(first.end) === 1));\n            }\n            used.add(first);\n            let next;\n            do {\n                const tip = chain[chain.length - 1].end;\n                next = infos.find((inf) => !used.has(inf) && (near(inf.start, tip) || near(inf.end, tip)));\n                if (next) {\n                    chain.push(orient(next, !near(next.start, tip)));\n                    used.add(next);\n                }\n            } while (next);\n            chains.push(chain);\n        }\n        const [bMin, bMax] = body.boundingBox.bounds;\n        const diagonal = Math.hypot(bMax[0] - bMin[0], bMax[1] - bMin[1], bMax[2] - bMin[2]);\n        EPS = Math.max(0.01, diagonal * 1e-5);\n        const throughDist = diagonal + 2 * EPS;\n        const smooth = (a, b) => a.tangent(a.len).dot(b.tangent(0)) > Math.cos(Math.PI / 180);\n        let tools = null;\n        const addTool = (tool) => {\n            tools = tools ? tools.fuse(tool) : tool;\n        };\n        const reverseChain = (chain) => chain\n            .slice()\n            .reverse()\n            .map((oe) => orient(oe.info, !oe.reversed));\n        chains.forEach((chain) => {\n            const closed = near(chain[chain.length - 1].end, chain[0].start);\n            // Pick where the wave starts: at the edge that was clicked first\n            const clicked = chain\n                .map((oe, i) => ({ i, rank: oe.info.rank, clicked: oe.info.clicked }))\n                .filter((c) => c.clicked)\n                .sort((a, b) => a.rank - b.rank);\n            if (!closed) {\n                // Open chain: start from whichever free end is nearer the first-clicked edge\n                if (clicked.length > 0) {\n                    const total = chain.reduce((sum, oe) => sum + oe.len, 0);\n                    let before = 0;\n                    for (let i = 0; i < clicked[0].i; i++)\n                        before += chain[i].len;\n                    if (before + chain[clicked[0].i].len / 2 > total / 2)\n                        chain = reverseChain(chain);\n                }\n            }\n            else if (clicked.length > 0) {\n                // Closed loop: start where the first-clicked edge begins, heading toward the second one\n                const first = clicked[0].i;\n                chain = chain.slice(first).concat(chain.slice(0, first));\n                const second = clicked.length > 1 ? (clicked[1].i - first + chain.length) % chain.length : 1;\n                if (second === chain.length - 1 && chain.length > 2) {\n                    chain = reverseChain(chain);\n                    chain = [chain[chain.length - 1], ...chain.slice(0, -1)];\n                }\n            }\n            else {\n                // Loop from a face selection has no click order: start at a sharp corner to hide the seam\n                // where the phase restarts\n                const corner = chain.findIndex((oe, i) => !smooth(chain[(i + chain.length - 1) % chain.length], oe));\n                if (corner > 0)\n                    chain = chain.slice(corner).concat(chain.slice(0, corner));\n            }\n            if (reverseStart)\n                chain = reverseChain(chain);\n            // The wave is drawn in a flat face shared by every edge in the chain\n            let common = adjacentFaces(chain[0].info.edge);\n            chain.forEach((oe) => {\n                const adj = adjacentFaces(oe.info.edge);\n                common = common.filter((i) => adj.includes(i));\n            });\n            common = common.filter((i) => faces[i].geomType === \"PLANE\");\n            if (common.length === 0) {\n                console.warn(\"Sine edge: touching edges must share a flat face, skipping\");\n                return;\n            }\n            // Default to the larger face (e.g. the top of a plate) so the side becomes wavy\n            common.sort((a, b) => replicad.measureArea(faces[b]) - replicad.measureArea(faces[a]));\n            const faceB = common[flipSide && common.length > 1 ? 1 : 0];\n            const nB = faces[faceB].normalAt(chain[0].start);\n            let u = 0;\n            for (const oe of chain) {\n                oe.u0 = u;\n                u += oe.len;\n                // Material is on the side away from the other adjacent face's normal\n                const faceA = adjacentFaces(oe.info.edge).find((i) => i !== faceB);\n                if (faceA === undefined) {\n                    console.warn(\"Sine edge: edge does not border two faces, skipping\");\n                    return;\n                }\n                const mid = oe.point(oe.len / 2);\n                const side = nB.cross(oe.tangent(oe.len / 2));\n                oe.inSign = side.dot(faces[faceA].normalAt(mid)) > 0 ? -1 : 1;\n            }\n            const plane = new replicad.Plane(chain[0].start.add(nB.multiply(EPS)), chain[0].tangent(0), nB);\n            const to2D = (v) => {\n                const d = v.sub(plane.origin);\n                return [d.dot(plane.xDir), d.dot(plane.yDir)];\n            };\n            // Unit direction into the material, and the point offset by offset.at(u) along it\n            const inward = (oe, s) => nB.cross(oe.tangent(s)).multiply(oe.inSign);\n            const offsetPoint = (oe, s, offset) => oe.point(s).add(inward(oe, s).multiply(offset.at(oe.u0 + s)));\n            // Derivative of offsetPoint along s\n            const offsetDeriv = (oe, s, offset) => {\n                const t = oe.tangent(s);\n                const u = oe.u0 + s;\n                let result = t.add(inward(oe, s).multiply(offset.slope(u)));\n                if (oe.info.edge.geomType !== \"LINE\") {\n                    // Rate at which the edge direction turns, from a small central difference\n                    const h = oe.len * 1e-4;\n                    const a = Math.max(0, s - h);\n                    const b = Math.min(oe.len, s + h);\n                    const dt = oe.tangent(b).sub(oe.tangent(a)).multiply(1 / (b - a));\n                    result = result.add(nB.cross(dt).multiply(oe.inSign * offset.at(u)));\n                }\n                return result;\n            };\n            // Hermite Bezier (matching position and slope at both ends) of an offset curve over [s0, s1].\n            // Handles use the circular-arc length (4/3)tan(θ/4) instead of the plain 1/3, which keeps\n            // curved edges accurate at any scale; on straight edges the two are identical.\n            const bezier = (oe, s0, s1, offset) => {\n                const cosTurn = Math.min(1, Math.max(-1, oe.tangent(s0).dot(oe.tangent(s1))));\n                const turn = Math.acos(cosTurn);\n                const h = turn > 1e-9 ? ((s1 - s0) * (4 / 3) * Math.tan(turn / 4)) / turn : (s1 - s0) / 3;\n                const p0 = offsetPoint(oe, s0, offset);\n                const p1 = offsetPoint(oe, s1, offset);\n                return {\n                    p0: to2D(p0),\n                    p1: to2D(p1),\n                    c1: to2D(p0.add(offsetDeriv(oe, s0, offset).multiply(h))),\n                    c2: to2D(p1.sub(offsetDeriv(oe, s1, offset).multiply(h))),\n                };\n            };\n            // Number of Beziers needed so each one turns by at most MAX_TURN\n            const turnPieces = (oe, span) => Math.ceil((span / oe.len) * oe.info.turn / MAX_TURN);\n            // Wave segments along one edge between s = sA and s = sB, split at every quarter wave\n            function waveSegs(oe, sA, sB) {\n                const segs = [];\n                if (sB - sA < 1e-9)\n                    return segs;\n                const breaks = [sA];\n                const quarter = wavelength / 4;\n                for (let m = Math.ceil((oe.u0 + sA) / quarter); m * quarter < oe.u0 + sB; m++) {\n                    const s = m * quarter - oe.u0;\n                    if (s > sA + 1e-6 && s < sB - 1e-6)\n                        breaks.push(s);\n                }\n                breaks.push(sB);\n                // A trimmed end can leave a sliver next to a quarter break; merge it and split in two instead\n                const sliver = quarter / 4;\n                const merged = new Set();\n                if (breaks.length > 2 && breaks[1] - breaks[0] < sliver) {\n                    breaks.splice(1, 1);\n                    merged.add(0);\n                }\n                if (breaks.length > 2 && breaks[breaks.length - 1] - breaks[breaks.length - 2] < sliver) {\n                    breaks.splice(breaks.length - 2, 1);\n                    merged.add(breaks.length - 2);\n                }\n                // On curved edges a single Bezier per quarter wave drifts, so use at least two\n                const minPieces = oe.info.edge.geomType !== \"LINE\" ? 2 : 1;\n                for (let i = 0; i + 1 < breaks.length; i++) {\n                    const n = Math.max(merged.has(i) ? 2 : minPieces, turnPieces(oe, breaks[i + 1] - breaks[i]));\n                    for (let j = 0; j < n; j++) {\n                        const s0 = breaks[i] + ((breaks[i + 1] - breaks[i]) * j) / n;\n                        const s1 = breaks[i] + ((breaks[i + 1] - breaks[i]) * (j + 1)) / n;\n                        segs.push(bezier(oe, s0, s1, wave));\n                    }\n                }\n                return segs;\n            }\n            // Segments just outside one edge, with the ends moved to the given corner points\n            function outerSegs(oe, startPt, endPt) {\n                let segs;\n                if (oe.info.edge.geomType === \"LINE\") {\n                    segs = [{ p0: to2D(offsetPoint(oe, 0, outside)), p1: to2D(offsetPoint(oe, oe.len, outside)) }];\n                }\n                else {\n                    const n = Math.max(1, turnPieces(oe, oe.len));\n                    segs = [];\n                    for (let j = 0; j < n; j++)\n                        segs.push(bezier(oe, (oe.len * j) / n, (oe.len * (j + 1)) / n, outside));\n                }\n                if (startPt)\n                    segs[0].p0 = startPt;\n                if (endPt)\n                    segs[segs.length - 1].p1 = endPt;\n                return segs;\n            }\n            // Classify each joint between consecutive edges (including the closing joint of a loop)\n            const joints = [];\n            const jointCount = closed ? chain.length : chain.length - 1;\n            for (let i = 0; i < jointCount; i++) {\n                const a = chain[i];\n                const b = chain[(i + 1) % chain.length];\n                const joint = { a, b, kind: smooth(a, b) ? \"smooth\" : \"sharp\" };\n                if (joint.kind === \"sharp\") {\n      