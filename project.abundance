            {
              "atomType": "Code",
              "x": 0.6,
              "y": 0.2,
              "uniqueID": "id-1788",
              "ioValues": [
                {
                  "name": "shape",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "count",
                  "ioValue": 5
                },
                {
                  "name": "distX",
                  "ioValue": 20
