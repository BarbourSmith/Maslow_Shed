                  "code": "function run(\n  shape: Assembly,\n  wavelength: number = 10,\n  depth: number = 2,\n  flipSide: boolean = false,\n) {\n  const EPS = 0.01; // how far the cutting tool extends outside the part\n  const TOL = 1e-4; // distance at which edge endpoints count as touching\n  const MAX_TURN = Math.PI / 8; // max direction change covered by one Bezier on a curved edge\n  const k = (2 * Math.PI) / wavelength;\n  // Depth into the material at arc length u along a chain: the wave, or just outside the part\n  const wave = {\n    at: (u: number) => (depth * (1 - Math.cos(k * u))) / 2,\n    slope: (u: number) => (depth * k * Math.sin(k * u)) / 2,\n  };\n  const outside = { at: (u: number) => -EPS, slope: (u: number) => 0 };\n\n  // Arc length -> normalized edge parameter lookup, plus total turning angle\n  function prepEdge(edge: replicad.Edge) {\n    const len = edge.length;\n    let toParam = (s: number) => s / len;\n    let turn = 0;\n    if (edge.geomType !== \"LINE\") {\n      const N = 32;\n      const params = [0];\n      const lengths = [0];\n      let prevP = edge.pointAt(0);\n      let prevT = edge.tangentAt(0).normalize();\n      for (let i = 1; i <= N; i++) {\n        const p = edge.pointAt(i / N);\n        const t = edge.tangentAt(i / N).normalize();\n        lengths.push(lengths[i - 1] + p.sub(prevP).Length);\n        params.push(i / N);\n        turn += Math.acos(Math.min(1, Math.max(-1, t.dot(prevT))));\n        prevP = p;\n        prevT = t;\n      }\n      if (edge.geomType !== \"CIRCLE\") {\n        const scale = len / lengths[N];\n        toParam = (s: number) => {\n          let i = 1;\n          while (i < N && lengths[i] * scale < s) i++;\n          const a = lengths[i - 1] * scale;\n          const b = lengths[i] * scale;\n          return params[i - 1] + ((s - a) / (b - a)) * (params[i] - params[i - 1]);\n        };\n      }\n    }\n    return { edge, len, toParam, turn, start: edge.startPoint, end: edge.endPoint };\n  }\n\n  // An edge traversed in chain direction; s runs 0..len along it\n  function orient(info: any, reversed: boolean) {\n    const param = (s: number) => info.toParam(reversed ? info.len - s : s);\n    return {\n      info,\n      len: info.len,\n      start: reversed ? info.end : info.start,\n      end: reversed ? info.start : info.end,\n      point: (s: number) => info.edge.pointAt(param(s)),\n      tangent: (s: number) =>\n        info.edge.tangentAt(param(s)).normalize().multiply(reversed ? -1 : 1),\n      u0: 0, // arc length along the chain where this edge starts\n      inSign: 1, // which side of the edge (within face B) the material is on\n    };\n  }\n\n  return shape.onLeafs((leaf) => {\n    if (leaf.geometry instanceof replicad.Drawing || !replicad.isShape3D(leaf.geometry)) {\n      return leaf;\n    }\n    const body = leaf.geometry;\n\n    // Gather the selected edges: edges of any selected faces, plus directly selected edges\n    let selectedEdges: replicad.Edge[] = [];\n    if (leaf.selection?.faces) {\n      leaf.selection.faces.forEach((faceIndex) => {\n        selectedEdges.push(...body.faces[faceIndex].edges);\n      });\n    }\n    if (leaf.selection?.edges) {\n      selectedEdges.push(...leaf.selection.edges.map((index) => body.edges[index]));\n    }\n    selectedEdges = selectedEdges.filter((e) => e != null);\n    // Faces share edges, so drop duplicates\n    selectedEdges = selectedEdges.filter(\n      (e, i) => selectedEdges.findIndex((other) => other.isSame(e)) === i,\n    );\n    if (selectedEdges.length === 0) {\n      return leaf;\n    }\n\n    const faces = body.faces;\n    const faceEdges = faces.map((f) => f.edges);\n    const adjacentFaces = (edge: replicad.Edge) =>\n      faces.map((f, i) => i).filter((i) => faceEdges[i].some((e) => e.isSame(edge)));\n\n    // Link touching edges into chains so the wave phase continues across them\n    const infos = selectedEdges.map(prepEdge);\n    const near = (a: replicad.Vector, b: replicad.Vector) => a.sub(b).Length < TOL;\n    const degree = (p: replicad.Vector) =>\n      infos.reduce((n, inf) => n + (near(inf.start, p) ? 1 : 0) + (near(inf.end, p) ? 1 : 0), 0);\n    const used = new Set<any>();\n    const chains: any[] = [];\n    while (used.size < infos.length) {\n      const remaining = infos.filter((inf) => !used.has(inf));\n      // Prefer starting at a free end so open chains are traversed end to end\n      let first = remaining.find((inf) => degree(inf.start) === 1);\n      let chain = [];\n      if (first) {\n        chain.push(orient(first, false));\n      } else {\n        first = remaining.find((inf) => degree(inf.end) === 1) ?? remaining[0];\n        chain.push(orient(first, degree(first.end) === 1));\n      }\n      used.add(first);\n      let next;\n      do {\n        const tip = chain[chain.length - 1].end;\n        next = infos.find((inf) => !used.has(inf) && (near(inf.start, tip) || near(inf.end, tip)));\n        if (next) {\n          chain.push(orient(next, !near(next.start, tip)));\n          used.add(next);\n        }\n      } while (next);\n      chains.push(chain);\n    }\n\n    const [bMin, bMax] = body.boundingBox.bounds;\n    const throughDist =\n      Math.hypot(bMax[0] - bMin[0], bMax[1] - bMin[1], bMax[2] - bMin[2]) + 2 * EPS;\n    const smooth = (a: any, b: any) => a.tangent(a.len).dot(b.tangent(0)) > Math.cos(Math.PI / 180);\n\n    let tools: replicad.Shape3D | null = null;\n    const addTool = (tool: replicad.Shape3D) => {\n      tools = tools ? tools.fuse(tool) : tool;\n    };\n\n    chains.forEach((chain) => {\n      const closed = near(chain[chain.length - 1].end, chain[0].start);\n\n      // The wave is drawn in a flat face shared by every edge in the chain\n      let common = adjacentFaces(chain[0].info.edge);\n      chain.forEach((oe: any) => {\n        const adj = adjacentFaces(oe.info.edge);\n        common = common.filter((i) => adj.includes(i));\n      });\n      common = common.filter((i) => faces[i].geomType === \"PL